# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de serviço: NUNCA prefixar com NEXT_PUBLIC_. Uso exclusivo em Route
# Handlers / Server Actions que precisam ignorar RLS (ex.: webhooks de pagamento).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL canônica usada nos redirects de e-mail do Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Checkout hospedado) — dashboard.stripe.com/test/apikeys em modo de teste.
# Sem chave publicável: o fotógrafo é redirecionado para a página do Stripe.
STRIPE_SECRET_KEY=sk_test_...
# Assinatura do webhook /api/webhooks/pagamento. Local: `stripe listen
# --forward-to localhost:3000/api/webhooks/pagamento` imprime um whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Segredo do webhook /api/webhooks/status: mesmo valor de
# private.app_config.webhook_secret no banco (ver migration 0006).
WEBHOOK_SECRET=

# Cloudflare R2 (fotos em alta). Bucket privado; token em R2 > Manage API Tokens
# com permissão Object Read & Write só neste bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Bucket PÚBLICO do R2 (vitrine e logos dos estúdios), servido pelo domínio
# próprio dele (R2 > bucket > Settings > Custom Domains). O mesmo token acima
# precisa de Object Read & Write também neste bucket.
R2_PUBLIC_BUCKET=
# Sem barra no final, ex.: https://midia.seualbum.com.br ou, sem domínio
# próprio, a URL r2.dev impressa por scripts/configurar-r2.sh (https://pub-....r2.dev)
R2_PUBLIC_URL=

# Cron da Vercel (/api/cron/limpar-fotos-r2): qualquer string longa e aleatória.
# Local, chame com: curl -H "Authorization: Bearer $CRON_SECRET" localhost:3000/api/cron/limpar-fotos-r2?dry_run=1
CRON_SECRET=

# Magic login do `next dev` (/auth/login): contas de teste, só lidas no servidor.
DEV_LOGIN_ADMIN_EMAIL=
DEV_LOGIN_ADMIN_PASSWORD=
DEV_LOGIN_FOTOGRAFO_EMAIL=
DEV_LOGIN_FOTOGRAFO_PASSWORD=
DEV_LOGIN_CLIENTE_EMAIL=
DEV_LOGIN_CLIENTE_PASSWORD=
DEV_LOGIN_DESIGNER_EMAIL=
DEV_LOGIN_DESIGNER_PASSWORD=
