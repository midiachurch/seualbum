# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de serviço: NUNCA prefixar com NEXT_PUBLIC_. Uso exclusivo em Route
# Handlers / Server Actions que precisam ignorar RLS (ex.: webhooks de pagamento).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL canônica usada nos redirects de e-mail do Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Checkout hospedado) — dashboard.stripe.com/test/apikeys em modo de teste.
# Sem chave publicável: o fotógrafo é redirecionado para a página do Stripe.
STRIPE_SECRET_KEY=sk_test_...
# Assinatura do webhook /api/webhooks/pagamento. Local: `stripe listen
# --forward-to localhost:3000/api/webhooks/pagamento` imprime um whsec_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Magic login do `next dev` (/auth/login): contas de teste, só lidas no servidor.
DEV_LOGIN_ADMIN_EMAIL=
DEV_LOGIN_ADMIN_PASSWORD=
DEV_LOGIN_FOTOGRAFO_EMAIL=
DEV_LOGIN_FOTOGRAFO_PASSWORD=
